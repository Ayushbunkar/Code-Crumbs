# Code&Crumbs Environment Variables

# Business & Notification Emails
CONTACT_EMAIL=codeandcrumbs.agency@gmail.com
CONTACT_FROM_EMAIL=codeandcrumbs.agency@gmail.com

# Transactional Email Provider (e.g. resend, postmark, smtp, or console)
# Options: "resend" | "postmark" | "smtp" | "console" (default in dev)
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=

# SMTP Configuration (only needed if EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Booking Calendar Integration (Cal.com, Google Calendar Appointment Scheduler)
# Leave empty to show the graceful fallback contact card
NEXT_PUBLIC_CALENDAR_URL=
